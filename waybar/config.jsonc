{
  // https://github.com/Alexays/Waybar/wiki/Configuration#bar-config
  "layer": "bottom",
  "position": "bottom",
  "height": 28,
  "mode": "dock",
  "include": ["~/.config/waybar/default-modules.jsonc", "~/.config/waybar/custom-modules.jsonc"],
  "modules-left": ["sway/workspaces", "custom/media", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": [
    "custom/updates",
    "idle_inhibitor",
    "custom/dunst",
    "network",
    "pulseaudio",
    "disk#root",
    "disk#home",
    "memory",
    "cpu",
    "temperature#CPU",
    "custom/gpu-usage",
    "temperature#GPU",
    "sway/language",
    "clock",
    "tray",
  ],
}
